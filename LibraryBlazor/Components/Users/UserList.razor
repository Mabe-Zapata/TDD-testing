@using System.Linq
@using LibraryCore
@inject LibraryService LibraryService

<div class="section-header">
    <h2>
        <i class="bi bi-people"></i>
        Gestion de Usuarios
    </h2>
    <button class="btn btn-primary" @onclick="OpenModal">
        <i class="bi bi-person-plus"></i>
        Nuevo Usuario
    </button>
</div>

<div class="alert alert-info" role="alert">
    <i class="bi bi-info-circle-fill"></i>
    <strong>Informacion:</strong> Los usuarios registrados podran realizar prestamos de libros.
    Consulte, busque y registre usuarios desde este panel.
</div>

@{
    var users = GetFilteredUsers().ToArray();
}

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
            <div class="flex-grow-1">
                <label class="form-label mb-1">
                    Buscar usuarios
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           class="form-control"
                           placeholder="Buscar por codigo o nombre completo..."
                           @bind="searchQuery"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => searchQuery = string.Empty">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            </div>
            <div>
                <span class="badge bg-primary">
                    <i class="bi bi-person-lines-fill"></i>
                    @users.Count() usuario@(users.Count() == 1 ? "" : "s")
                </span>
            </div>
        </div>

        @if (users.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Codigo</th>
                            <th>Nombre</th>
                            <th style="width: 220px;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>
                                    <span class="code-badge">
                                        <i class="bi bi-person-badge"></i>
                                        @user.Code
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-circle text-primary"></i>
                                        <div>
                                            <strong>@user.FirstName @user.LastName</strong>
                                            <div class="text-muted small">Cliente</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i>
                                        Registrado
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-person-check" style="font-size: 4rem; color: var(--bs-success);"></i>
                <h5 class="mt-3">Sistema de Registro de Usuarios</h5>
                <p class="text-muted">
                    Registre usuarios para que puedan solicitar prestamos de libros en la biblioteca.
                </p>
                <button class="btn btn-primary" @onclick="OpenModal">
                    <i class="bi bi-plus-circle"></i>
                    Registrar Primer Usuario
                </button>
            </div>
        }
    </div>
</div>

<!-- Modal -->
<UserFormModal IsOpen="isModalOpen" IsOpenChanged="OnModalOpenChanged" OnSuccess="HandleSuccess" />

@code {
    [Parameter] public EventCallback<string> OnSuccess { get; set; }

    private bool isModalOpen = false;
    private string searchQuery = string.Empty;

    private IEnumerable<User> GetFilteredUsers()
    {
        return LibraryService.SearchUsers(searchQuery ?? string.Empty);
    }

    private void OpenModal()
    {
        isModalOpen = true;
    }

    private async Task OnModalOpenChanged(bool isOpen)
    {
        isModalOpen = isOpen;
        StateHasChanged();
    }

    private async Task HandleSuccess(string message)
    {
        await OnSuccess.InvokeAsync(message);
        searchQuery = string.Empty;
        StateHasChanged();
    }
}
