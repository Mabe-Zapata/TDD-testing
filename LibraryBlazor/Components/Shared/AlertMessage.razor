@if (IsVisible)
{
    <div class="alert alert-@GetAlertClass() alert-dismissible fade show" role="alert">
        <i class="bi @GetIcon()"></i>
        <strong>@Title</strong> @Message
        @if (Dismissible)
        {
            <button type="button" class="btn-close" @onclick="Dismiss"></button>
        }
    </div>
}

@code {
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Type { get; set; } = "info";
    [Parameter] public bool Dismissible { get; set; } = true;
    [Parameter] public bool AutoDismiss { get; set; } = false;
    [Parameter] public int AutoDismissDelay { get; set; } = 5000;
    [Parameter] public EventCallback OnDismiss { get; set; }

    private bool IsVisible { get; set; }
    private Timer? _timer;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Message))
        {
            Show();
        }
    }

    public void Show()
    {
        IsVisible = true;

        if (AutoDismiss)
        {
            _timer?.Dispose();
            _timer = new Timer(_ => InvokeAsync(Dismiss), null, AutoDismissDelay, Timeout.Infinite);
        }

        StateHasChanged();
    }

    public async Task Dismiss()
    {
        IsVisible = false;
        _timer?.Dispose();
        await OnDismiss.InvokeAsync();
        StateHasChanged();
    }

    private string GetAlertClass()
    {
        return Type.ToLower();
    }

    private string GetIcon()
    {
        return Type.ToLower() switch
        {
            "success" => "bi-check-circle-fill",
            "danger" => "bi-exclamation-triangle-fill",
            "warning" => "bi-exclamation-circle-fill",
            "info" => "bi-info-circle-fill",
            "primary" => "bi-info-circle-fill",
            "secondary" => "bi-info-circle-fill",
            _ => "bi-info-circle-fill"
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
