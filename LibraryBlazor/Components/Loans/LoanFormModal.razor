@using System.Linq
@using LibraryCore
@using LibraryBlazor.Models
@inject LibraryService LibraryService

<div class="modal fade @(IsOpen ? "show d-block" : "")" tabindex="-1" style="@(IsOpen ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-bookmark-plus-fill"></i>
                    Crear Nuevo Prestamo
                </h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>

            <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="modal-body loan-modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Error:</strong> @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    <ValidationSummary class="validation-summary" />

                    <!-- Seccion: Identificacion del Prestamo -->
                    <div class="modal-section">
                        <div class="modal-section-title">
                            <i class="bi bi-hash"></i>
                            Identificacion del Prestamo
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                ID del Prestamo
                                <span class="required">*</span>
                            </label>
                            <InputText @bind-Value="model.LoanId" class="form-control" placeholder="Ej: LOAN001" />
                            <ValidationMessage For="@(() => model.LoanId)" class="invalid-feedback" />
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i>
                                Identificador unico para este prestamo
                            </div>
                        </div>
                    </div>

                    <!-- Seccion: Seleccion de Libro -->
                    <div class="modal-section">
                        <div class="modal-section-title">
                            <i class="bi bi-book"></i>
                            Seleccion de Libro
                        </div>

                        <div class="position-relative mb-3">
                            <label class="form-label">
                                Libro
                                <span class="required">*</span>
                            </label>
                            <div class="input-group">
                                <input type="text"
                                       class="form-control"
                                       placeholder="Buscar por codigo, titulo o autor..."
                                       value="@BookSearchTerm"
                                       @oninput="OnBookInputChanged"
                                       disabled="@(selectedBook != null)" />

                                @if (selectedBook != null)
                                {
                                    <button type="button" class="btn btn-outline-danger" @onclick="ClearBookSelection">
                                        <i class="bi bi-x-circle"></i>
                                        Limpiar
                                    </button>
                                }
                            </div>
                            <ValidationMessage For="@(() => model.BookCode)" class="invalid-feedback" />

                            @if (bookSuggestions.Any() && selectedBook == null)
                            {
                                <div class="list-group suggestion-list">
                                    @foreach (var book in bookSuggestions)
                                    {
                                        <button type="button"
                                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                @onclick="() => SelectBook(book)">
                                            <div>
                                                <div class="fw-semibold">
                                                    <i class="bi bi-book"></i>
                                                    @book.Title
                                                </div>
                                                <small class="text-muted">
                                                    @book.Author | Código: @book.Code
                                                </small>
                                            </div>
                                            <span class="badge bg-success">
                                                @book.Copies disponible@(book.Copies == 1 ? "" : "s")
                                            </span>
                                        </button>
                                    }
                                </div>
                            }

                            @if (selectedBook != null)
                            {
                                <div class="alert alert-success mb-0 mt-2" role="alert">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <i class="bi bi-check-circle-fill"></i>
                                            <strong>Libro Seleccionado:</strong>
                                            <div class="mt-2">
                                                <div><strong>Título:</strong> @selectedBook.Title</div>
                                                <div><strong>Autor:</strong> @selectedBook.Author</div>
                                                <div><strong>Código:</strong> @selectedBook.Code</div>
                                                <div><strong>Copias disponibles:</strong> @selectedBook.Copies</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="form-text">
                                    <i class="bi bi-info-circle"></i>
                                    Escriba al menos 2 caracteres para buscar libros disponibles
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Seccion: Seleccion de Usuario -->
                    <div class="modal-section">
                        <div class="modal-section-title">
                            <i class="bi bi-person"></i>
                            Seleccion de Usuario
                        </div>

                        <div class="position-relative mb-3">
                            <label class="form-label">
                                Usuario
                                <span class="required">*</span>
                            </label>
                            <div class="input-group">
                                <input type="text"
                                       class="form-control"
                                       placeholder="Buscar por codigo o nombre completo..."
                                       value="@UserSearchTerm"
                                       @oninput="OnUserInputChanged"
                                       disabled="@(selectedUser != null)" />

                                @if (selectedUser != null)
                                {
                                    <button type="button" class="btn btn-outline-danger" @onclick="ClearUserSelection">
                                        <i class="bi bi-x-circle"></i>
                                        Limpiar
                                    </button>
                                }
                            </div>

                            <ValidationMessage For="@(() => model.UserCode)" class="invalid-feedback" />

                            @if (userSuggestions.Any() && selectedUser == null)
                            {
                                <div class="list-group suggestion-list">
                                    @foreach (var user in userSuggestions)
                                    {
                                        <button type="button"
                                                class="list-group-item list-group-item-action"
                                                @onclick="() => SelectUser(user)">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-circle text-primary fs-4"></i>
                                                <div>
                                                    <div class="fw-semibold">@user.FirstName @user.LastName</div>
                                                    <small class="text-muted">Código: @user.Code</small>
                                                </div>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }

                            @if (selectedUser != null)
                            {
                                <div class="alert alert-primary mb-0 mt-2" role="alert">
                                    <i class="bi bi-person-check-fill"></i>
                                    <strong>Usuario Seleccionado:</strong>
                                    <div class="mt-2">
                                        <div><strong>Nombre:</strong> @selectedUser.FirstName @selectedUser.LastName</div>
                                        <div><strong>Código:</strong> @selectedUser.Code</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="form-text">
                                    <i class="bi bi-info-circle"></i>
                                    Escriba al menos 2 caracteres para buscar usuarios
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Seccion: Resumen del Prestamo -->
                    @if (selectedBook != null && selectedUser != null)
                    {
                        <div class="modal-section">
                            <div class="modal-section-title">
                                <i class="bi bi-clipboard-check"></i>
                                Resumen del Prestamo
                            </div>

                            <div class="summary-box">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">
                                        <i class="bi bi-hash"></i> ID Préstamo:
                                    </dt>
                                    <dd class="col-sm-8">
                                        <strong>@(string.IsNullOrEmpty(model.LoanId) ? "(Por definir)" : model.LoanId)</strong>
                                    </dd>

                                    <dt class="col-sm-4">
                                        <i class="bi bi-book"></i> Libro:
                                    </dt>
                                    <dd class="col-sm-8">
                                        <strong>@selectedBook.Title</strong>
                                        <br />
                                        <small class="text-muted">Autor: @selectedBook.Author</small>
                                        <br />
                                        <small class="text-muted">Código: @selectedBook.Code</small>
                                    </dd>

                                    <dt class="col-sm-4">
                                        <i class="bi bi-person"></i> Usuario:
                                    </dt>
                                    <dd class="col-sm-8">
                                        <strong>@selectedUser.FirstName @selectedUser.LastName</strong>
                                        <br />
                                        <small class="text-muted">Código: @selectedUser.Code</small>
                                    </dd>

                                    <dt class="col-sm-4">
                                        <i class="bi bi-calendar"></i> Fecha:
                                    </dt>
                                    <dd class="col-sm-8">
                                        <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </dd>
                                </dl>
                            </div>

                            <div class="alert alert-info mb-0 mt-3">
                                <i class="bi bi-info-circle-fill"></i>
                                <strong>Confirme los datos antes de crear el préstamo</strong>
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">
                        <i class="bi bi-x-circle"></i>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@(isSubmitting || selectedBook == null || selectedUser == null)">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                        }
                        Crear Prestamo
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .suggestion-list {
        position: absolute;
        z-index: 1000;
        width: 100%;
        max-height: 300px;
        overflow-y: auto;
        margin-top: 4px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .suggestion-list .list-group-item:hover {
            background-color: #f8f9fa;
            cursor: pointer;
        }

    .summary-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1.5rem;
    }

        .summary-box dt {
            font-weight: 600;
            color: #495057;
        }

        .summary-box dd {
            margin-bottom: 1rem;
        }

            .summary-box dd:last-child {
                margin-bottom: 0;
            }

    .modal-section {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e9ecef;
    }

        .modal-section:last-of-type {
            border-bottom: none;
            margin-bottom: 0;
        }

    .modal-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 1rem;
    }

    .required {
        color: #dc3545;
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<string> OnSuccess { get; set; }

    private LoanFormModel model = new();
    private string errorMessage = string.Empty;
    private bool isSubmitting = false;

    // Objetos seleccionados completos
    private Book? selectedBook = null;
    private User? selectedUser = null;

    private IEnumerable<Book> bookSuggestions = Enumerable.Empty<Book>();
    private IEnumerable<User> userSuggestions = Enumerable.Empty<User>();

    private string _bookSearchTerm = string.Empty;
    private string _userSearchTerm = string.Empty;

    private string BookSearchTerm
    {
        get => _bookSearchTerm;
        set
        {
            if (_bookSearchTerm == value) return;

            _bookSearchTerm = value;
            UpdateBookSuggestions(value);
        }
    }

    private string UserSearchTerm
    {
        get => _userSearchTerm;
        set
        {
            if (_userSearchTerm == value) return;

            _userSearchTerm = value;
            UpdateUserSuggestions(value);
        }
    }

    private void UpdateBookSuggestions(string term)
    {
        if (!HasMinimumSearchLength(term))
        {
            bookSuggestions = Enumerable.Empty<Book>();
            return;
        }

        bookSuggestions = GetBookSuggestions(term).ToList();
    }

    private IEnumerable<Book> GetBookSuggestions(string term)
    {
        return LibraryService.SearchBooks(term)
            .Where(book => book.Copies > 0)
            .Take(10);
    }

    private void UpdateUserSuggestions(string term)
    {
        if (!HasMinimumSearchLength(term))
        {
            userSuggestions = Enumerable.Empty<User>();
            return;
        }

        userSuggestions = GetUserSuggestions(term).ToList();
    }

    private IEnumerable<User> GetUserSuggestions(string term)
    {
        return LibraryService.SearchUsers(term)
            .Take(10);
    }

    private static bool HasMinimumSearchLength(string? term)
    {
        return !string.IsNullOrWhiteSpace(term) && term.Trim().Length >= 2;
    }

    private void SelectBook(Book book)
    {
        selectedBook = book;
        model.BookCode = book.Code;
        _bookSearchTerm = $"{book.Title} - {book.Author}";
        bookSuggestions = Enumerable.Empty<Book>();
    }

    private void SelectUser(User user)
    {
        selectedUser = user;
        model.UserCode = user.Code;
        _userSearchTerm = $"{user.FirstName} {user.LastName}";
        userSuggestions = Enumerable.Empty<User>();
    }


    private void OnBookInputChanged(ChangeEventArgs e)
    {
        var term = e.Value?.ToString() ?? string.Empty;
        BookSearchTerm = term;   
    }

    private void OnUserInputChanged(ChangeEventArgs e)
    {
        var term = e.Value?.ToString() ?? string.Empty;
        UserSearchTerm = term;   
    }

    private void ClearBookSelection()
    {
        selectedBook = null;
        model.BookCode = string.Empty;
        BookSearchTerm = string.Empty;
        bookSuggestions = Enumerable.Empty<Book>();
    }

    private void ClearUserSelection()
    {
        selectedUser = null;
        model.UserCode = string.Empty;
        UserSearchTerm = string.Empty;
        userSuggestions = Enumerable.Empty<User>();
    }

    private async Task HandleValidSubmit()
    {
        if (selectedBook == null || selectedUser == null)
        {
            errorMessage = "Debe seleccionar un libro y un usuario";
            return;
        }

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            LibraryService.LendBook(
                model.LoanId,
                model.BookCode,
                model.UserCode
            );

            await OnSuccess.InvokeAsync($"Prestamo '{model.LoanId}' creado exitosamente");
            await Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
        ResetForm();
    }

    private void ResetForm()
    {
        model = new LoanFormModel();
        errorMessage = string.Empty;
        isSubmitting = false;

        selectedBook = null;
        selectedUser = null;

        bookSuggestions = Enumerable.Empty<Book>();
        userSuggestions = Enumerable.Empty<User>();

        _bookSearchTerm = string.Empty;
        _userSearchTerm = string.Empty;
    }
}